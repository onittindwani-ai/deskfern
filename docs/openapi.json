      "type": "string",
      "maxLength": 60,
      "title": "Owner",
      "default": "support lead"
     }
    },
    "type": "object",
    "required": [
     "reason"
    ],
    "title": "EscalateIn"
   },
   "GapStatusIn": {
    "properties": {
     "status": {
      "type": "string",
      "pattern": "^(open|covered|dismissed)$",
      "title": "Status"
     }
    },
    "type": "object",
    "required": [
     "status"
    ],
    "title": "GapStatusIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Login": {
    "properties": {
     "email": {
      "type": "string",
      "maxLength": 254,
      "title": "Email"
     },
     "password": {
      "type": "string",
      "maxLength": 1024,
      "title": "Password"
     }
    },
    "type": "object",
    "required": [
     "email",
     "password"
    ],
    "title": "Login"
   },
   "ReplyIn": {
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 8000,
      "minLength": 1,
      "title": "Text"
     }
    },
    "type": "object",
    "required": [
     "text"
    ],
    "title": "ReplyIn"
   },
   "ResolveIn": {
    "properties": {
     "delivered": {
      "type": "boolean",
      "title": "Delivered"
     }
    },
    "type": "object",
    "required": [
     "delivered"
    ],
    "title": "ResolveIn"
   },
   "RuleIn": {
    "properties": {
     "monthly_days": {
      "type": "integer",
      "maximum": 365.0,
      "minimum": 0.0,
      "title": "Monthly Days"
     },
     "annual_days": {
      "type": "integer",
      "maximum": 365.0,
      "minimum": 0.0,
      "title": "Annual Days"
     },
     "max_per_12m": {
      "type": "integer",
      "maximum": 12.0,
      "minimum": 0.0,
      "title": "Max Per 12M"
     },
     "always_full": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Always Full",
      "default": []
     }
    },
    "type": "object",
    "required": [
     "monthly_days",
     "annual_days",
     "max_per_12m"
    ],
    "title": "RuleIn"
   },
   "SettingsIn": {
    "properties": {
     "kill_switch": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Kill Switch"
     },
     "force_draft": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Force Draft"
     }
    },
    "type": "object",
    "title": "SettingsIn"
   },
   "SourceIn": {
    "properties": {
     "kind": {
      "type": "string",
      "pattern": "^(site|drive|notion)$",
      "title": "Kind"
     },
     "name": {
      "type": "string",
      "maxLength": 120,
      "minLength": 2,
      "title": "Name"
     },
     "uri": {
      "type": "string",
      "maxLength": 500,
      "title": "Uri",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "kind",
     "name"
    ],
    "title": "SourceIn"
   },
   "StressIn": {
    "properties": {
     "n": {
      "type": "integer",
      "maximum": 20000.0,
      "minimum": 1.0,
      "title": "N"
     }
    },
    "type": "object",
    "required": [
     "n"
    ],
    "title": "StressIn"
   },
   "TextDocIn": {
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 200,
      "minLength": 2,
      "title": "Title"
     },
     "text": {
      "type": "string",
      "maxLength": 200000,
      "minLength": 20,
      "title": "Text"
     }
    },
    "type": "object",
    "required": [
     "title",
     "text"
    ],
    "title": "TextDocIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
