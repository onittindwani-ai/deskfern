      "type": "string",
      "maxLength": 500,
      "title": "Note",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "approve"
    ],
    "title": "DecideIn"
   },
   "EraseIn": {
    "properties": {
     "email": {
      "type": "string",
      "maxLength": 254,
      "minLength": 3,
      "title": "Email"
     }
    },
    "type": "object",
    "required": [
     "email"
    ],
    "title": "EraseIn"
   },
   "EscalateIn": {
    "properties": {
     "reason": {
      "type": "string",
      "maxLength": 500,
      "minLength": 3,
      "title": "Reason"
     },
