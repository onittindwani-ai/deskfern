# Deskfern environment. Names only. Copy to .env and fill in what you use. Never commit .env.
# A group of settings you leave empty is treated as switched off.

# Core
APP_NAME=deskfern
DATABASE_URL=sqlite:///./deskfern.sqlite3
SESSION_SECRET=change-me-to-a-long-random-string
MODE=draft
DEMO_MODE=true
KILL_SWITCH=false
# Model for answers: offline (default, built in stand in, no account), fixture (recorded answers) or anthropic (needs a key, UNVERIFIED against the real service)
LLM_BACKEND=offline
# Let a model rescue a reply sentence the rules are unsure about (rules or model). The code checks its quote. Needs a model backend that is not offline to do anything.
JUDGE=rules
# Add a model's second look to the ticket triage (off or model). It can only add warnings, never remove one.
TRIAGE_ASSIST=off
KNOWLEDGE_DIR=
SEED_DIR=

# Owner login (DEMO_MODE off needs a real password hash, see tools/hash_password.py)
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD_HASH=
APPROVER_EMAIL=
APPROVER_PASSWORD_HASH=
VIEWER_EMAIL=
VIEWER_PASSWORD_HASH=
LOGIN_BURST=5

# Which adapters to use (seed means offline)
HELPDESK_ADAPTER=seed
INBOX_ADAPTER=seed
EMAIL_ADAPTER=seed
PAYMENTS_ADAPTER=seed

# First reply targets in hours (decided defaults, change them to the service levels you promise)
SLA_URGENT_H=1
SLA_HIGH_H=4
SLA_NORMAL_H=24
SLA_LOW_H=72
# The clock counts business hours by default. Use round_the_clock to count every hour.
SLA_CLOCK=business
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
BUSINESS_DAYS=mon,tue,wed,thu,fri
OFFICE_TIMEZONE=America/New_York

# Site crawl limits
CRAWL_MAX_PAGES=25
CRAWL_MAX_DEPTH=3
CRAWL_MAX_BYTES=1000000
CRAWL_DELAY_S=0.5

# Chatwoot
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_WEBHOOK_SECRET=

# Intercom
INTERCOM_TOKEN=
INTERCOM_ADMIN_ID=

# Zendesk
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_TOKEN=

# Freshdesk
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# Stripe refunds
STRIPE_SECRET_KEY=

# Google Drive source
DRIVE_TOKEN=

# Notion source
NOTION_TOKEN=

# Email in and out
IMAP_HOST=
IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=support@example.test

# Web app (set on the web host)
API_BASE_URL=http://127.0.0.1:8000
