# Deskfern environment. Names only. Copy to .env and fill in what you use. Never commit .env. Every name is explained in docs/04-ENVIRONMENT-VARIABLES.md.
# A group whose heading says "all or none" is switched off when you leave it empty and must be filled in completely once you start.

# Core
APP_NAME=deskfern
DATABASE_URL=sqlite:///./deskfern.sqlite3
# Make one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"  (32 or more random characters; the app and the worker refuse to start on this example value when DEMO_MODE is false, an owner password is set, or MODE is live)
SESSION_SECRET=change-me-to-a-long-random-string
# draft: nothing is sent and nothing is paid. live: real replies and refunds, only after docs/09-GO-LIVE-CHECKLIST.md
MODE=draft
# false for any real install. true is the offline demo with fictional data (it also switches on a public demo password until OWNER_PASSWORD_HASH is set)
DEMO_MODE=false
# Only for a throw away demo on a server database. Leave false.
ALLOW_DEMO_SERVER=false
KILL_SWITCH=false
# The largest request the API accepts, in bytes (25 MB)
MAX_BODY_BYTES=26214400
# Docker compose only: the database password. Letters and digits only. Make one: openssl rand -hex 24
POSTGRES_PASSWORD=
# A folder of markdown, text and PDF files read as the knowledge base (press Read the folder now on the Knowledge page, or run python -m deskfern.admin sync-knowledge)
KNOWLEDGE_DIR=
# The folder with the demo data. Set automatically when you run from the repository.
SEED_DIR=

# Sign in (make the hash with: python tools/hash_password.py). Keep the single quotes.
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD_HASH=
# Required when MODE=live with a real payment system (PAYMENTS_ADAPTER=stripe): the second person who approves refunds. Not the owner's address.
APPROVER_EMAIL=
APPROVER_PASSWORD_HASH=
VIEWER_EMAIL=
VIEWER_PASSWORD_HASH=
LOGIN_BURST=5

# Who the desk speaks for. COMPANY_NAME and EMAIL_FROM are placeholders until you change them, and a live start is refused while they are.
COMPANY_NAME=Fieldnote Software
# The three letter code printed on refund requests (the amounts come from the payment system in its smallest unit)
CURRENCY=USD
# Let a self hosted helpdesk (Chatwoot on your own network) sit on a private address. Leave false for a hosted one.
ALLOW_PRIVATE_BASE_URLS=false

# Who a message really comes from. An address that cannot be checked is never matched to a customer, so no account or payment facts are used for it (docs/13).
REQUIRE_VERIFIED_SENDER=true
# The name your mail provider puts first in its Authentication-Results header, for example mx.google.com. Empty means email senders are never verified.
INBOUND_AUTHSERV_ID=
# Helpdesk channels whose own login already proves the address, comma separated: chatwoot, intercom, zendesk, freshdesk, email
TRUSTED_SENDER_CHANNELS=

# Model for answers: offline (default, built in stand in, no account), fixture (recorded answers) or anthropic (needs a key, UNVERIFIED against the real service)
LLM_BACKEND=offline
# The older switch: live means anthropic when LLM_BACKEND is empty. Leave it.
LLM_MODE=fixture
# Let a model rescue a reply sentence the rules are unsure about (rules or model). The code checks its quote. Needs a model backend that is not offline to do anything.
JUDGE=rules
# Add a model's second look to the ticket triage (off or model). It can only add warnings, never remove one.
TRIAGE_ASSIST=off

# Model settings, used only when LLM_BACKEND is anthropic or fixture
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2026-10-21
LLM_HARD_MODEL=claude-sonnet-5-5
LLM_BULK_MODEL=claude-haiku-5-5
# One model id for both kinds. Empty uses the two above.
LLM_MODEL=
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=2
# Spend limits for the live model: the most calls per process and the most tracked spend in US dollars. Raise them on purpose.
LLM_CALL_BUDGET=200
LLM_BUDGET_USD=5
LLM_THINKING=default
LLM_FIXTURES_DIR=
LLM_RECORD=false
LLM_REDACT=true
LLM_LOG_PROMPTS=false

# Which adapter each job uses (seed means offline). Replies leave through the helpdesk adapter, or through the email adapter for tickets that came in by email.
HELPDESK_ADAPTER=seed
INBOX_ADAPTER=seed
EMAIL_ADAPTER=seed
PAYMENTS_ADAPTER=seed

# First reply targets in hours (decided defaults, change them to the service levels you promise)
SLA_URGENT_H=1
SLA_HIGH_H=4
SLA_NORMAL_H=24
SLA_LOW_H=72
# The clock counts business hours by default. Use round_the_clock to count every hour.
SLA_CLOCK=business
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
BUSINESS_DAYS=mon,tue,wed,thu,fri
OFFICE_TIMEZONE=America/New_York

# Site crawl limits
CRAWL_MAX_PAGES=25
CRAWL_MAX_DEPTH=3
CRAWL_MAX_BYTES=1000000
CRAWL_DELAY_S=0.5
# The most seconds one whole crawl may take, and the most bytes it may read in all. The worker runs the crawl, so the worker must be running.
CRAWL_DEADLINE_S=120
CRAWL_TOTAL_BYTES=10000000

# What the desk keeps. Finished tickets (replied, refused, duplicate, closed) older than this many days lose their words, once a day. 0 keeps everything for ever.
RETENTION_DAYS=730
# Told by email when a ticket is handed to a person. Empty sends nothing. Needs EMAIL_ADAPTER=smtp; draft mode and Pause all hold the notice back.
ESCALATION_NOTIFY_EMAIL=

# Chatwoot (all or none)
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_WEBHOOK_SECRET=

# Intercom (all or none)
INTERCOM_TOKEN=
INTERCOM_ADMIN_ID=
INTERCOM_BASE_URL=https://api.intercom.io

# Zendesk (all or none)
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_TOKEN=
ZENDESK_BASE_URL=

# Freshdesk (all or none)
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
FRESHDESK_BASE_URL=

# Stripe refunds (all or none)
STRIPE_SECRET_KEY=
STRIPE_BASE_URL=https://api.stripe.com

# Google Drive source (all or none)
DRIVE_TOKEN=
DRIVE_BASE_URL=https://www.googleapis.com

# Notion source (all or none)
NOTION_TOKEN=
NOTION_BASE_URL=https://api.notion.com

# Email in and out. One account signs in for both. Plain text (false below) is refused for any host but 127.0.0.1.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
IMAP_HOST=
IMAP_PORT=993
IMAP_USE_SSL=true
# The address replies are sent from. A placeholder until you change it.
EMAIL_FROM=support@example.test

# Web app (set on the web host)
API_BASE_URL=http://127.0.0.1:8000
